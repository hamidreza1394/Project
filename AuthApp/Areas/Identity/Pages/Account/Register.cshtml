@page
@model RegisterModel

@{
    ViewData["Title"] = "ثبت‌نام";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ثبت‌نام | AuthApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Vazirmatn', sans-serif; }
    </style>
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-icon">✨</div>
            <h2>ثبت‌نام</h2>
            <p class="auth-subtitle">یک حساب کاربری جدید ایجاد کنید</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" asp-page="/Account/Register" asp-area="Identity" asp-route-returnUrl="@Model.ReturnUrl">
                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" placeholder="ایمیل" autocomplete="email" />
                    <label asp-for="Input.Email">ایمیل</label>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger" style="font-size:0.85rem;"></span>

                <div class="form-floating" style="margin-top:15px;">
                    <input asp-for="Input.Password" class="form-control" placeholder="رمز عبور" autocomplete="new-password" />
                    <label asp-for="Input.Password">رمز عبور</label>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger" style="font-size:0.85rem;"></span>

                <div class="form-floating" style="margin-top:15px;">
                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="تکرار رمز عبور" autocomplete="new-password" />
                    <label asp-for="Input.ConfirmPassword">تکرار رمز عبور</label>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:0.85rem;"></span>

                <button type="submit" class="btn-auth" style="margin-top:20px;">ثبت‌نام</button>
            </form>

            <div class="auth-divider">
                <span>یا</span>
            </div>

            <div class="auth-links">
                <p>قبلاً حساب دارید؟ <a asp-page="/Account/Login" asp-area="Identity">وارد شوید</a></p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
